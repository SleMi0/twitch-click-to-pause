{
  "manifest_version": 3,
  "name": "Twitch Click to Pause",
  "version": "1.0.0",
  "description": "Click anywhere on the Twitch video to pause or resume playback.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.twitch.tv/*"],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
